{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug",
      "Yarp.ReverseProxy": "Debug"
    }
  },
  "Gateway": {
    "Dashboard": {
      "RoutePrefix": "aneiang",
      "EnableProxyResponseBodyCapture": true,
      "Tracing": {
        "Enabled": false,
        "ExportEnabled": true,
        "ServiceName": "sample-gateway",
        "Environment": "development",
        "Endpoint": "http://localhost:4317",
        "Protocol": "grpc",
        "SamplingRatio": 1.0,
        "RecordPluginSpans": true,
        "RecordAspNetCoreSpans": true,
        "RecordHttpClientSpans": true,
        "RecentTraceCapacity": 100,
        "MaxSpansPerTrace": 64
      },
      "Auth": {
        "AuthMode": "DefaultJwt",
        "JwtPassword": "demo123"
      }
    },
    "Storage": {
      "Provider": "Sqlite",
      "Sqlite": {
        "ConnectionString": "Data Source=gateway-store.db;Password=123456"
      },
      "Environments": {
        "Runtime": "prod",
        "Names": [
          "prod",
          "staging",
          "dev"
        ]
      },
      "Redis": {
        "ConnectionString": "localhost:6379",
        "Prefix": "aneiang:",
        "Database": 0
      }
    },
    "Deployment": {
      "Mode": "AllInOne",
      "RequireLoopbackForDashboard": false,
      "HealthCheck": {
        "Enabled": true
      },
      "HotReload": {
        "Enabled": true
      }
    }
  },
  "AI": {
    "Enabled": false,
    "Provider": "deepseek",
    "ApiKey": "",
    "BaseUrl": "https://api.deepseek.com/v1",
    "ChatModel": "deepseek-v4-flash",
    "AnalysisModel": "deepseek-v4-flash",
    "MaxTokens": 4096,
    "Temperature": 0.7,
    "MaxHistory": 20,
    "ReasoningEffort": "auto",
    "UseCache": true,
    "BgAnalysis": false,
    "EnhanceNotif": false,
    "Fallback": {
      "Enabled": false,
      "Provider": "",
      "ApiKey": "",
      "BaseUrl": "",
      "Model": ""
    },
    "McpServer": {
      "Enabled": false,
      "Port": 8090
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Gateway": {
        "Url": "http://0.0.0.0:5200"
      },
      "Grpc": {
        "Url": "http://0.0.0.0:5201",
        "Protocols": "Http2"
      }
    }
  }
}
