@{
    var isEn = (ViewBag.Locale as string) == "en-US";
    ViewData["Title"] = isEn ? "Cluster Metrics" : "集群指标";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@await Html.PartialAsync("~/Views/Dashboard/Partials/_ClusterMetricsPanel.cshtml")

@section Scripts {
<script src="/_content/Aneiang.Yarp.Dashboard/js/modules/dashboard-cluster-metrics.js"></script>

@await Html.PartialAsync("_DashboardPageInit")

<script>
    (async function() {
        var basePath = '/' + '@(ViewBag.DashboardRoutePrefix ?? "apigateway")';
        if (window.DashboardUtils) DashboardUtils.init();
        if (window.DashboardApi) DashboardApi.init();
        if (window.DashboardState) DashboardState.init();
        if (window.DashboardI18n) DashboardI18n.init();
        if (window.DashboardStorage) DashboardStorage.init();
        if (window.DashboardModals) DashboardModals.init();
        if (window.DashboardEvents) DashboardEvents.setup();

        try {
            if (window.DashboardApi) {
                var plugin = await DashboardApi.getPlugin('cluster-metrics');
                if (plugin && plugin.enabled && window.ClusterMetricsModule) {
                    await ClusterMetricsModule.load();
                }
            }
        } catch(e) { console.error('ClusterMetrics load error:', e); }

        // 数据来源诊断条：未启用 / 未绑定 / 等待数据 / 运行中，各给一个可点的下一步
        if (window.DashboardDataSource) {
            await DashboardDataSource.mount({
                containerId: 'cm-datasource',
                pluginId: 'cluster-metrics',
                scope: 'Cluster',
                // 未进入运行中时，把面板里的加载动画换成空状态，避免一直转圈
                emptyContainerId: 'cm-content',
                hasData: function() {
                    // 模块在无数据时会渲染一行 colspan 占位，必须排除掉，否则空页会被判成「运行中」
                    if (!document.querySelector('#cm-content tbody tr')) return false;
                    return !document.querySelector('#cm-content tbody td[colspan]');
                },
                onRefresh: function() {
                    return reloadClusterMetrics();
                }
            });

            // 用户点「启用插件」成功后自动补一次拉数
            document.addEventListener('datasource:enabled', function(evt) {
                if (evt.detail && evt.detail.pluginId === 'cluster-metrics') {
                    reloadClusterMetrics();
                }
            });
        }

        function reloadClusterMetrics() {
            if (!window.ClusterMetricsModule) return Promise.resolve();
            return Promise.resolve(ClusterMetricsModule.load()).then(function() {
                if (window.DashboardDataSource) DashboardDataSource.refresh('cluster-metrics');
            });
        }

        // 绑定配置统一放在「插件配置」页（plugin-center#cluster-metrics）
        document.dispatchEvent(new CustomEvent('dashboard:ready'));
    })();
</script>
}
