@* Partial: Circuits monitor panel (no config sub-panel - managed by PluginCenter) *@
<div id="circuits-app">
    @* 数据来源诊断条：由 js/core/dashboard-datasource.js 按插件状态渲染 *@
    <div class="ds-host" id="circuit-datasource" data-plugin="circuit-breaker" data-scope="Cluster"></div>
    <div class="pc-panel-head">
        <div class="pc-panel-title"><i class="bi bi-lightning-charge me-2" style="color: var(--warning-color);"></i><span data-i18n="circuit.title">熔断状态</span></div>
        <div class="pc-panel-actions">
            <span id="circuit-refresh-time" class="refresh-badge"></span>
            <button class="pr-refresh-btn" onclick="CircuitModule.load()" data-i18n-title="index.btn.refresh" title="刷新" aria-label="刷新">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
            <button class="btn btn-sm btn-outline-danger" onclick="CircuitModule.resetAll()" data-i18n-title="circuit.reset" title="重置">
                <i class="bi bi-x-circle"></i> <span data-i18n="circuit.reset">全部重置</span>
            </button>
        </div>
    </div>
    <div id="circuit-content">
            <div class="loading-state">
                <div class="loading-spinner"></div>
                <div class="loading-text" data-i18n="circuit.loading">加载中...</div>
            </div>
        </div>
    </div>
</div>
