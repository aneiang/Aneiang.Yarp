@using Aneiang.Yarp.Plugin.ProxyLog.Models
@{
    var isEn = (ViewBag.Locale as string) == "en-US";
    ViewData["Title"] = isEn ? "Plugin Overview" : "插件总览";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}
@await Html.PartialAsync("~/Views/Dashboard/Partials/_PluginSubNav.cshtml")

<style>
    /* Scope chip: which target type this plugin can be bound to */
    .plg-scope {
        display: inline-block;
        font-size: 10px; font-weight: 700; line-height: 1;
        padding: 3px 6px; border-radius: 4px;
        letter-spacing: .02em; white-space: nowrap;
    }
    .plg-scope + .plg-scope { margin-left: 4px; }
    .plg-scope--route   { background: #eff6ff; color: #2563eb; }
    .plg-scope--cluster { background: #f0fdf4; color: #15803d; }
    /* Enabled but bound to no target: visible so "on" is never mistaken for "working" */
    .plg-unbound { color: #b45309; font-weight: 600; }
    /* The one state with an unambiguous next step gets a labelled button. */
    .plg-bind-cta { white-space: nowrap; padding: 2px 9px; font-size: 12px; }
</style>

<div id="plugins-app">
    <div class="card-panel mb-4">
        <div class="card-header">
            <span><i class="bi bi-puzzle me-2" style="color:#8b5cf6;"></i><span data-i18n="menu.plugins">插件总览</span></span>
            <div class="card-header-actions">
                <span id="plugin-refresh-time" class="refresh-badge"></span>
                <button class="btn btn-sm btn-outline-secondary" onclick="PluginModule.resetAll()" data-i18n-title="plugin.resetAll" title="全部启用">
                    <i class="bi bi-check-all"></i> <span data-i18n="plugin.resetAll">全部启用</span>
                </button>
                <button class="btn btn-sm btn-outline-secondary btn-icon-only" onclick="PluginModule.load()" data-i18n-title="index.btn.refresh" title="刷新" aria-label="刷新">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
        </div>
        <div id="plugin-content" class="card-body">
            <div class="loading-state">
                <div class="loading-spinner"></div>
                <div class="loading-text" data-i18n="plugin.loading">加载中...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
@{ var v = typeof(LogEntry).Assembly.GetName().Version?.ToString() ?? DateTime.Now.Ticks.ToString(); }
<script src="/_content/Aneiang.Yarp.Dashboard/js/modules/dashboard-plugins.js?v=@v"></script>

@await Html.PartialAsync("_DashboardPageInit")

<script>
    (async function() {
        if (window.DashboardUtils) DashboardUtils.init();
        if (window.DashboardApi) DashboardApi.init();
        if (window.DashboardState) DashboardState.init();
        if (window.DashboardI18n) DashboardI18n.init();
        if (window.DashboardStorage) DashboardStorage.init();
        if (window.DashboardModals) DashboardModals.init();
        if (window.DashboardEvents) DashboardEvents.setup();
        if (window.DashboardApp && window.DashboardApp.modules && window.DashboardApp.modules.plugin) {
            await DashboardApp.modules.plugin.init();
        }
        await PluginModule.load();
        document.dispatchEvent(new CustomEvent('dashboard:ready'));
    })();
</script>
}
