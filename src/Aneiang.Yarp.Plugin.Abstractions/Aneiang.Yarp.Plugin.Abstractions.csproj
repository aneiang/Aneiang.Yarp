<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net8.0 is not legacy here, it is the floor of the plugin ecosystem: every out-of-tree plugin
      project (and every project generated by `dotnet new aneiang-yarp-plugin` before .NET 10) has a
      PackageReference to this package. Dropping the net8.0 asset turns their next restore into
      NU1202 — an integration break with no code change on their side. Adding a target is free;
      removing one is a breaking change for the package consumers.
    -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Aneiang.Yarp.Plugin.Abstractions</PackageId>
    <Description>Plugin contract abstractions for Aneiang.Yarp gateway plugins.</Description>
    <PackageTags>yarp;reverse-proxy;gateway;plugin;abstractions;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

</Project>
