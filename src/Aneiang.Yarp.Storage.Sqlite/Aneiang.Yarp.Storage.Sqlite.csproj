<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Aneiang.Yarp.Storage.Sqlite</PackageId>
    <Description>SQLite storage implementation for Aneiang.Yarp.</Description>
    <PackageTags>yarp;reverse-proxy;gateway;storage;sqlite;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core, not the meta package: the meta package drags in SQLitePCLRaw.bundle_e_sqlite3,
         which both carries the vulnerable lib.e_sqlite3 (GHSA-2m69-gcr7-jv3q) and competes with
         the SQLCipher provider over Batteries_V2.Init(). SqliteNativeProvider covers the manual
         provider init that Core requires. See docs/security/security-remediation.md SEC-14/15. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.4" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aneiang.Yarp.Storage.Abstractions\Aneiang.Yarp.Storage.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the encryption tests install the provider the same way the host does. -->
    <InternalsVisibleTo Include="Aneiang.Yarp.UnitTests" />
  </ItemGroup>

</Project>
