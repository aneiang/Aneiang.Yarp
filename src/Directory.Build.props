<Project>

  <PropertyGroup>
    <Version>2.3.0.41</Version>
    <Authors>AneiangSoft Team</Authors>
    <Company>AneiangSoft</Company>
    <Copyright>Copyright © AneiangSoft $([System.DateTime]::Now.Year)</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>logo.png</PackageIcon>
    <PackageProjectUrl>https://github.com/aneiang/Aneiang.Yarp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/aneiang/Aneiang.Yarp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\nupkg</PackageOutputPath>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!--
      SEC-17: analyzers were implicit. The SDK turns a subset on by default, but "whatever this SDK
      version defaults to" is not a decision — a pinned level is, and it keeps the baseline from
      shifting when the SDK moves. Security rules are raised separately below because the default
      mode leaves most of the CA53xx family off.
    -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
  </PropertyGroup>

  <!--
    Package metadata files live at the repository root, one level above this props file.

    Forward slashes and PackagePath="/" are deliberate. On Linux a backslash inside an item
    Include is not a directory separator, so "..\logo.png" is a file name, not a parent path;
    once a pack pipeline normalizes that name, the same file can be counted twice and NuGet
    fails the whole pack with NU5050 ("logo.png" used multiple times). One spelling, one entry.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Link="README.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../README.zh-CN.md" Link="README.zh-CN.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../logo.png" Link="logo.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <!--
    Pack the icon exactly once.

    The file named by PackageIcon can reach _PackageFiles through more than one path: the <None>
    item above, and whatever the toolchain derives from the icon metadata itself. Both resolve to
    "/logo.png", and NuGet does not de-duplicate them — it fails the entire pack with NU5050
    ("/logo.png used multiple times"). Collapse every root-level icon entry back to a single one so
    the result does not depend on which of those paths a given SDK/NuGet build happens to take.
    Match on PackagePath, not file name: a file-name match also removes the Dashboard's static asset
    (staticwebassets/images/logo.png), leaving its props pointing at a file missing from the package.
  -->
  <Target Name="_AneiangPackIconOnce" AfterTargets="_GetPackageFiles" Condition="'$(PackageIcon)' != ''">
    <ItemGroup>
      <_AneiangIconEntry Include="@(_PackageFiles)"
        Condition="'%(PackagePath)' == '/$(PackageIcon)' Or '%(PackagePath)' == '$(PackageIcon)'" />
      <_PackageFiles Remove="@(_AneiangIconEntry)" />
      <_PackageFiles Include="$(MSBuildThisFileDirectory)../logo.png" Link="$(PackageIcon)" PackagePath="/" BuildAction="None" />
    </ItemGroup>
  </Target>

</Project>
