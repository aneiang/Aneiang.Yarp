<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- No direct Microsoft.Data.Sqlite reference: the meta package re-introduces
         SQLitePCLRaw.bundle_e_sqlite3 (GHSA-2m69-gcr7-jv3q). Microsoft.Data.Sqlite.Core already
         arrives through Aneiang.Yarp.Storage.Sqlite, and SqliteConnectionFactory initializes the
         SQLCipher provider, so SqliteConnection is usable here without it. -->
    <ProjectReference Include="..\..\src\Aneiang.Yarp\Aneiang.Yarp.csproj" />
    <ProjectReference Include="..\..\src\Aneiang.Yarp.Dashboard\Aneiang.Yarp.Dashboard.csproj" />
    <ProjectReference Include="..\..\src\Aneiang.Yarp.Storage.Sqlite\Aneiang.Yarp.Storage.Sqlite.csproj" />
  </ItemGroup>
</Project>
